
{
  "info": {
    "name": "Product Service",
    "_postman_id": "a6f4b8ab-6a2a-4c40-9f8f-a2c8a1c0f0f1",
    "description": "Requests for the local Product Service API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "productId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "Create product",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Desk Lamp\",\n  \"description\": \"LED desk lamp\",\n  \"price\": 25.50,\n  \"quantity\": 12,\n  \"category\": \"Lighting\",\n  \"status\": \"ACTIVE\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/products"
      }
    },
    {
      "name": "List products",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/products?page=0&size=10&sort=price,asc"
      }
    },
    {
      "name": "Get product",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/products/{{productId}}"
      }
    },
    {
      "name": "Replace product",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Updated Desk Lamp\",\n  \"description\": \"Updated LED desk lamp\",\n  \"price\": 30.00,\n  \"quantity\": 15,\n  \"category\": \"Lighting\",\n  \"status\": \"ACTIVE\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/products/{{productId}}"
      }
    },
    {
      "name": "Patch product",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"quantity\": 20\n}"
        },
        "url": "{{baseUrl}}/api/v1/products/{{productId}}"
      }
    },
    {
      "name": "Delete product",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/api/v1/products/{{productId}}"
      }
    }
  ]
}
